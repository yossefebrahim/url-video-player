# Copy to `.env` (gitignored) and fill in. `.env` holds sensitive/secret data
# that must NOT be committed.
#
# Ground-truth vectors for the HLS key-unwrap cipher, captured by running the
# original app's native libnext.so on-device. Format: blobHex:keyHex pairs,
# comma-separated. Without this, the ground-truth test in
# test/hls_key_decryptor_test.dart is skipped (the other cases still run).
HLS_KEY_TEST_VECTORS=<blobHex>:<keyHex>,<blobHex>:<keyHex>
